{
  "name": "@kubejs/generator",
  "version": "1.2.0",
  "description": "A generator for KubeJS plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/MDReal32/bundled-kubejs.git",
    "directory": "libs/generator"
  },
  "type": "module",
  "main": "build/kubejs.generator.js",
  "bin": {
    "kubejs-generator": "bin/generator.js"
  },
  "files": [
    "build",
    "bin",
    "templates"
  ],
  "scripts": {
    "check": "yarn run -T biome check .",
    "prepublishOnly": "yarn build",
    "publish:me": "yarn npm publish --access public",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@kubejs/core": "workspace:^",
    "@t3-oss/env-core": "^0.13.11",
    "ejs": "3.1.10",
    "lodash": "^4.18.1",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.5",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.1",
    "yargs": "18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/ejs": "^3.1.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@types/yargs": "17.0.35",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
