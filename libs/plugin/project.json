{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/npm/*/build"],
      "inputs": [
        "default",
        "^default",
        {
          "env": "MC_LINE"
        }
      ]
    }
  }
}
