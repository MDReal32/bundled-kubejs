{
  "name": "@kubejs/plugin",
  "version": "1.2.14",
  "description": "A KubeJS plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/MDReal32/bundled-kubejs.git",
    "directory": "libs/plugin"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./npm/mc-1.21/build/kubejs.plugin.d.ts",
      "import": "./npm/mc-1.21/build/kubejs.plugin.js",
      "require": "./npm/mc-1.21/build/kubejs.plugin.js"
    },
    "./tsconfig": {
      "default": "./tsconfig.base.json"
    },
    "./tsconfig.json": {
      "default": "./tsconfig.base.json"
    }
  },
  "main": "npm/mc-1.21/build/kubejs.plugin.js",
  "types": "npm/mc-1.21/build/kubejs.plugin.d.ts",
  "files": [
    "npm/mc-1.21/build",
    "npm/mc-1.21/bin",
    "npm/mc-1.21/types",
    "tsconfig.base.json"
  ],
  "scripts": {
    "check": "yarn run -T biome check .",
    "dev": "vite-node src/cli.ts",
    "publish:me": "yarn npm publish --access public",
    "build:mc-1.18": "vite build --config npm/mc-1.18/vite.config.ts",
    "build:mc-1.19": "vite build --config npm/mc-1.19/vite.config.ts",
    "build:mc-1.20": "vite build --config npm/mc-1.20/vite.config.ts",
    "build:mc-1.21": "vite build --config npm/mc-1.21/vite.config.ts"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@kubejs/core": "^2.0.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@swc/core": "1.16.20",
    "@t3-oss/env-core": "^0.13.11",
    "chokidar": "^4.0.3",
    "glob": "^11.1.0",
    "lodash": "4.18.1",
    "magic-string": "^0.30.21",
    "vite": "7.3.7",
    "yargs": "18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/babel__preset-env": "^7.10.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/yargs": "17.0.35",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "vite-node": "^3.2.4",
    "vite-plugin-dts": "4.5.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "bin": {
    "kubejs": "npm/mc-1.21/bin/cli.js"
  }
}
